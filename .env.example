# Variabilele de mediu ale aplicației de evaluare (/evaluare). Doar NUME, fără valori:
# repo-ul este public. Valorile se pun în Vercel (Settings → Environment Variables) sau,
# pentru lucru local, într-un fișier .env.local (ignorat de git).
#
# Fără ele: în dezvoltare și în teste nu se trimite nimic (transport fals);
# în producție, „Trimite” afișează un mesaj de eroare și nu se pierde nimic din formular.

# Adresa la care ajung fișele. Apare și în textul de informare de sub bifa de acord.
EVALUARE_EMAIL_TO=
# Expeditorul afișat. De regulă trebuie să fie adresa contului SMTP.
EVALUARE_EMAIL_FROM=

# Serverul SMTP prin care pleacă emailurile.
SMTP_HOST=
# 465 (TLS) sau 587 (STARTTLS)
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
